{
  "name": "time-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts src/db/migrate.ts src/db/seed.ts src/db/rotate.ts src/db/purge.ts --target=bun --root=src --outdir=dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:migrate:prod": "bun dist/db/migrate.js",
    "db:purge": "bun src/db/purge.ts",
    "db:purge:prod": "bun dist/db/purge.js",
    "db:rotate": "bun src/db/rotate.ts",
    "db:rotate:prod": "bun dist/db/rotate.js",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:demo": "bun src/db/demo.ts",
    "db:seed:prod": "bun dist/db/seed.js",
    "dev": "bun --watch src/server.ts",
    "docs:typedoc": "typedoc",
    "lint": "eslint . --max-warnings=0",
    "openapi:generate": "bun scripts/openapi.ts",
    "start": "bun dist/server.js",
    "test:integration": "bun test tests/integration",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/otel": "^0.21.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/request-context": "^7.0.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "5",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.3",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0"
  }
}
