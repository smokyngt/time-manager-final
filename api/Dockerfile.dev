# syntax=docker/dockerfile:1
# Development image: all dependencies, source is bind-mounted by docker-compose.dev.yml.
FROM oven/bun:1.4.5@sha256:3aa040e5445efa09d75bb428a64ba50db13e2b3ac9b6b0c7f145615f62b2ee18
WORKDIR /app

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

COPY . .

ENV NODE_ENV=development
EXPOSE 8000
CMD ["bun", "run", "dev"]
