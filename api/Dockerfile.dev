# syntax=docker/dockerfile:1
# Development image: all dependencies, source is bind-mounted by docker-compose.dev.yml.
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598
WORKDIR /app

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --ignore-scripts

COPY . .

ENV NODE_ENV=development
EXPOSE 8000
CMD ["bun", "run", "dev"]
